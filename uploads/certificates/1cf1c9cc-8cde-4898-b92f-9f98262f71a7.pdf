<svg xmlns="http://www.w3.org/2000/svg" width="850" height="1100" viewBox="0 0 850 1100">
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0f172a"/>
        <stop offset="100%" stop-color="#020617"/>
      </linearGradient>
      <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#1e293b"/>
        <stop offset="100%" stop-color="#0f172a"/>
      </linearGradient>
      <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#38bdf8"/>
        <stop offset="100%" stop-color="#818cf8"/>
      </linearGradient>
    </defs>

    <!-- Background -->
    <rect width="850" height="1100" fill="url(#bgGrad)"/>
    <rect x="35" y="35" width="780" height="1030" rx="20" fill="url(#cardGrad)" stroke="#334155" stroke-width="2"/>
    <rect x="55" y="55" width="740" height="990" rx="14" fill="none" stroke="#38bdf8" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="8,4"/>

    <!-- Header Badge Icon -->
    <circle cx="425" cy="180" r="55" fill="#1e3a8a" opacity="0.4"/>
    <circle cx="425" cy="180" r="42" fill="#0284c7" opacity="0.2"/>
    <path d="M395 180 L415 202 L455 156" fill="none" stroke="#38bdf8" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Title & Subtitle -->
    <text x="425" y="275" fill="#f8fafc" font-family="'Segoe UI', Roboto, sans-serif" font-size="30" font-weight="bold" text-anchor="middle" letter-spacing="0.5">SSLC Mark List</text>
    <text x="425" y="315" fill="#94a3b8" font-family="'Segoe UI', Roboto, sans-serif" font-size="16" text-anchor="middle">OFFICIAL STUDENT EDUCATIONAL CERTIFICATE</text>
    <line x1="120" y1="350" x2="730" y2="350" stroke="#334155" stroke-width="2"/>

    <!-- Certificate Information Table Box -->
    <rect x="100" y="390" width="650" height="340" rx="14" fill="#090d16" stroke="#1e293b" stroke-width="1.5"/>

    <text x="130" y="440" fill="#38bdf8" font-family="'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="bold" letter-spacing="1">CERTIFICATE METADATA</text>
    
    <text x="130" y="490" fill="#94a3b8" font-family="sans-serif" font-size="15">Certificate Name:</text>
    <text x="320" y="490" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="600">SSLC Mark List</text>

    <text x="130" y="535" fill="#94a3b8" font-family="sans-serif" font-size="15">Submitted File:</text>
    <text x="320" y="535" fill="#60a5fa" font-family="sans-serif" font-size="15">12 th marksheet.pdf</text>

    <text x="130" y="580" fill="#94a3b8" font-family="sans-serif" font-size="15">Student Holder:</text>
    <text x="320" y="580" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="600">Praveen Kumar K</text>

    <text x="130" y="625" fill="#94a3b8" font-family="sans-serif" font-size="15">Status:</text>
    <text x="320" y="625" fill="#34d399" font-family="sans-serif" font-size="15" font-weight="bold">VERIFIED &amp; STORED IN DATABASE</text>

    <text x="130" y="670" fill="#94a3b8" font-family="sans-serif" font-size="15">System ID:</text>
    <text x="320" y="670" fill="#cbd5e1" font-family="monospace" font-size="14">SDMS-CERT-2026-OK</text>

    <!-- Official Stamp Footer -->
    <rect x="100" y="770" width="650" height="210" rx="14" fill="#0f172a" stroke="#1e293b" stroke-width="1.5"/>
    <circle cx="210" cy="875" r="48" fill="#1e293b" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4,2"/>
    <text x="210" y="870" fill="#38bdf8" font-family="sans-serif" font-size="11" font-weight="bold" text-anchor="middle">SDMS</text>
    <text x="210" y="888" fill="#34d399" font-family="sans-serif" font-size="10" font-weight="bold" text-anchor="middle">VERIFIED</text>
    
    <text x="300" y="845" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold">Student Database Management System</text>
    <text x="300" y="875" fill="#94a3b8" font-family="sans-serif" font-size="14">Digital Records Repository — Department Archive</text>
    <text x="300" y="905" fill="#64748b" font-family="sans-serif" font-size="12">Document hash validated against database registry.</text>
  </svg>